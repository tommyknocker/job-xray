{
  "manifest_version": 3,
  "name": "job-xray",
  "version": "0.1.4",
  "description": "Surfaces hidden hh.ru vacancy response counters (total, unread, per day, real age). UI labels are Russian on the site.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://hh.ru/*",
        "*://*.hh.ru/*"
      ],
      "js": ["src/network-hook.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://hh.ru/*",
        "*://*.hh.ru/*"
      ],
      "js": ["loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js", "page-network-hook.js"],
      "matches": [
        "*://hh.ru/*",
        "*://*.hh.ru/*"
      ]
    }
  ]
}
